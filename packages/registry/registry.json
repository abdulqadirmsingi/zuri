{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "zuri",
  "homepage": "https://zuri.dev",
  "items": [
    {
      "name": "zuri-tokens",
      "type": "registry:style",
      "title": "Zuri tokens",
      "description": "Colour, glass and motion tokens used by Zuri components.",
      "cssVars": {
        "theme": {
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-muted": "var(--muted)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-border": "var(--border)",
          "color-ring": "var(--ring)",
          "color-success": "var(--success)",
          "color-warning": "var(--warning)",
          "color-danger": "var(--danger)"
        },
        "light": {
          "background": "oklch(0.99 0.003 260)",
          "foreground": "oklch(0.2 0.02 260)",
          "muted": "oklch(0.96 0.006 260)",
          "muted-foreground": "oklch(0.45 0.02 260)",
          "primary": "oklch(0.52 0.19 275)",
          "primary-foreground": "oklch(0.99 0 0)",
          "border": "oklch(0.9 0.008 260)",
          "ring": "oklch(0.55 0.2 275)",
          "success": "oklch(0.5 0.14 155)",
          "warning": "oklch(0.55 0.14 75)",
          "danger": "oklch(0.52 0.2 25)",
          "glass-blur": "16px",
          "glass-bg": "oklch(1 0 0 / 0.72)",
          "glass-border": "oklch(0.2 0.02 260 / 0.12)",
          "glass-solid": "oklch(0.98 0.004 260)",
          "duration-base": "200ms",
          "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)"
        },
        "dark": {
          "background": "oklch(0.16 0.015 260)",
          "foreground": "oklch(0.96 0.005 260)",
          "muted": "oklch(0.22 0.015 260)",
          "muted-foreground": "oklch(0.72 0.015 260)",
          "primary": "oklch(0.7 0.16 275)",
          "primary-foreground": "oklch(0.16 0.015 260)",
          "border": "oklch(0.3 0.015 260)",
          "ring": "oklch(0.72 0.16 275)",
          "success": "oklch(0.75 0.15 155)",
          "warning": "oklch(0.8 0.14 80)",
          "danger": "oklch(0.72 0.17 25)",
          "glass-bg": "oklch(0.22 0.015 260 / 0.72)",
          "glass-border": "oklch(1 0 0 / 0.14)",
          "glass-solid": "oklch(0.2 0.015 260)"
        }
      },
      "css": {
        "@layer components": {
          ".zuri-glass": {
            "background": "var(--glass-bg)",
            "border": "1px solid var(--glass-border)",
            "box-shadow": "0 16px 40px oklch(0.2 0.02 260 / 0.12)",
            "-webkit-backdrop-filter": "blur(var(--glass-blur))",
            "backdrop-filter": "blur(var(--glass-blur))"
          }
        },
        "@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))": {
          ".zuri-glass": {
            "background": "var(--glass-solid)"
          }
        },
        "@media (prefers-reduced-transparency: reduce)": {
          ".zuri-glass": {
            "background": "var(--glass-solid)",
            "-webkit-backdrop-filter": "none",
            "backdrop-filter": "none"
          }
        }
      },
      "meta": {
        "version": "0.1.0",
        "tier": "free"
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "An accessible button with default, outline, ghost and glass variants.",
      "dependencies": ["class-variance-authority", "clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/actions/button/button.tsx",
          "type": "registry:ui"
        }
      ],
      "categories": ["actions"],
      "meta": {
        "version": "0.1.0",
        "tier": "free"
      },
      "registryDependencies": ["__REGISTRY_URL__/zuri-tokens.json"]
    }
  ]
}
