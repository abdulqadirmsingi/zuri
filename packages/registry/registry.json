{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "zuri",
  "homepage": "https://zuri.dev",
  "items": [
    {
      "name": "zuri-tokens",
      "type": "registry:style",
      "title": "Zuri tokens",
      "description": "Colour, glass and motion tokens used by Zuri components.",
      "cssVars": {
        "theme": {
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-muted": "var(--muted)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-accent": "var(--accent)",
          "color-accent-foreground": "var(--accent-foreground)",
          "color-accent-ink": "var(--accent-ink)",
          "color-border": "var(--border)",
          "color-ring": "var(--ring)",
          "color-success": "var(--success)",
          "color-warning": "var(--warning)",
          "color-danger": "var(--danger)",
          "color-control-border": "var(--control-border)"
        },
        "light": {
          "background": "oklch(0.99 0 0)",
          "foreground": "oklch(0.16 0 0)",
          "muted": "oklch(0.96 0 0)",
          "muted-foreground": "oklch(0.45 0 0)",
          "primary": "oklch(0.18 0 0)",
          "primary-foreground": "oklch(0.99 0 0)",
          "accent": "oklch(0.76 0.16 60)",
          "accent-foreground": "oklch(0.18 0 0)",
          "accent-ink": "oklch(0.52 0.14 50)",
          "border": "oklch(0.9 0 0)",
          "ring": "oklch(0.18 0 0)",
          "success": "oklch(0.5 0.14 155)",
          "warning": "oklch(0.52 0.12 70)",
          "danger": "oklch(0.52 0.2 25)",
          "control-border": "oklch(0.6 0 0)"
        },
        "dark": {
          "background": "oklch(0.14 0 0)",
          "foreground": "oklch(0.97 0 0)",
          "muted": "oklch(0.2 0 0)",
          "muted-foreground": "oklch(0.72 0 0)",
          "primary": "oklch(0.97 0 0)",
          "primary-foreground": "oklch(0.14 0 0)",
          "accent": "oklch(0.78 0.15 62)",
          "accent-foreground": "oklch(0.18 0 0)",
          "accent-ink": "oklch(0.8 0.14 62)",
          "border": "oklch(0.3 0 0)",
          "ring": "oklch(0.97 0 0)",
          "success": "oklch(0.75 0.15 155)",
          "warning": "oklch(0.8 0.14 80)",
          "danger": "oklch(0.72 0.17 25)",
          "control-border": "oklch(0.55 0 0)"
        }
      },
      "css": {
        ":root": {
          "--glass-blur": "16px",
          "--glass-bg": "oklch(1 0 0 / 0.72)",
          "--glass-border": "oklch(0 0 0 / 0.12)",
          "--glass-solid": "oklch(0.98 0 0)",
          "--duration-base": "200ms",
          "--ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
          "--duration-fast": "120ms",
          "--duration-slow": "300ms",
          "--ease-in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
          "--z-dropdown": "1000",
          "--z-sticky": "1100",
          "--z-overlay": "1200",
          "--z-modal": "1300",
          "--z-toast": "1400",
          "--z-tooltip": "1500"
        },
        ".dark": {
          "--glass-bg": "oklch(0.2 0 0 / 0.72)",
          "--glass-border": "oklch(1 0 0 / 0.14)",
          "--glass-solid": "oklch(0.2 0 0)"
        },
        "@layer components": {
          ".zuri-glass": {
            "background": "var(--glass-bg)",
            "border": "1px solid var(--glass-border)",
            "box-shadow": "0 16px 40px oklch(0 0 0 / 0.12)",
            "-webkit-backdrop-filter": "blur(var(--glass-blur))",
            "backdrop-filter": "blur(var(--glass-blur))"
          }
        },
        "@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)))": {
          ".zuri-glass": {
            "background": "var(--glass-solid)"
          }
        },
        "@media (prefers-reduced-transparency: reduce)": {
          ".zuri-glass": {
            "background": "var(--glass-solid)",
            "-webkit-backdrop-filter": "none",
            "backdrop-filter": "none"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          ":root": {
            "--duration-fast": "0.01ms",
            "--duration-base": "0.01ms",
            "--duration-slow": "0.01ms"
          }
        }
      },
      "meta": {
        "version": "0.1.0",
        "tier": "free"
      }
    },
