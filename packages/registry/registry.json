      "name": "otp-input",
      "type": "registry:ui",
      "title": "Verification code",
      "description": "A verification code field: digits rise into cells, a full code is checked, and the cells fuse into a Verified capsule or the row shakes and clears.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/inputs/otp-input/otp-input.tsx",
