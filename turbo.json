{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@zuri/registry#registry:build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@zuri/registry#registry:build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "@zuri/registry#registry:build"]
    },
    "test": {
      "dependsOn": ["^build", "@zuri/registry#registry:build"]
    },
    "registry:build": {
      "outputs": ["../../apps/web/.registry/**"],
      "env": ["ZURI_REGISTRY_URL", "ZURI_REGISTRY_OUT"]
    }
  }
}
