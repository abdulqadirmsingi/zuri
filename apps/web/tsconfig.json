{
  "extends": "@zuri/config/tsconfig.react.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "allowJs": false,
    "incremental": true,
    "paths": {
      "@/components/ui/button": ["../../packages/registry/src/actions/button/button"],
      "@/*": ["./*"],
      "@registry/*": ["../../packages/registry/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
