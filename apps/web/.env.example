# Copy to apps/web/.env.local and fill in. Everything here is optional: the site and the
# registry work without it, they just do not count installs or gate Pro items.

# Postgres connection string. Local Docker default (see docker-compose.yml):
DATABASE_URL=postgres://zuri:zuri_dev@127.0.0.1:5432/zuri
# Secret for the daily visitor hash. Required for install counting.
# Generate with: openssl rand -hex 32
ZURI_HASH_SECRET=

# Owner-only admin (/api/admin/*, and the /admin dashboard). Disabled unless set, 32+ characters.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
# Max /r requests per minute per client (default 120).
ZURI_RATE_LIMIT_PER_MIN=

# Public URL of the deployed site (used for absolute links). Production: https://components.abdulqadirmsingi.com
NEXT_PUBLIC_SITE_URL=
